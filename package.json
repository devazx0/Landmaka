{
  "name": "landmaka",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "node api.js && turbo run build",
    "dev": "node api.js && turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "2.10.12",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "unrs-resolver",
      "sharp",
      "esbuild",
      "prisma",
      "@prisma/engines",
      "@prisma/client"
    ]
  }
}
